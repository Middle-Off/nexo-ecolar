# Variáveis de ambiente — NexoEscolar Backend
# Copie este arquivo para .env e preencha com seus valores reais

# Conexão com o banco de dados PostgreSQL
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL="postgresql://postgres:senha@localhost:5432/nexo_escolar"

# Chave secreta para assinar e verificar tokens JWT
# IMPORTANTE: Use uma string longa e aleatória em produção!
JWT_SECRET="substitua_por_uma_chave_secreta_longa_e_aleatoria"

# Tempo de expiração dos tokens JWT (ex: 1h, 7d, 30d)
JWT_EXPIRES_IN="8h"

# Porta em que o servidor Express vai escutar
PORT=3333

# Ambiente de execução
NODE_ENV="development"
